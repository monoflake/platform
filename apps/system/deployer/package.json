{
	"name": "@monoflake/deployer",
	"private": true,
	"description": "Workers deployed as host deploys images.",
	"keywords": [
		"cloudflare-workers",
		"deploy",
		"wrangler"
	],
	"type": "module",
	"scripts": {
		"dev": "node src/main.ts",
		"bundle": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node26 --outfile=dist/main.mjs"
	},
	"dependencies": {
		"wrangler": "4.147.0"
	},
	"devDependencies": {
		"@canmi/response": "^2.0.0",
		"@hono/node-server": "^2.1.3",
		"@monoflake/sdk": "workspace:*",
		"esbuild": "^0.28.2"
	}
}
