{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "console",
	"main": "worker/index.ts",
	"compatibility_date": "2026-07-29",

	// The page is the files `vite build` wrote; the script runs first only for the paths it answers,
	// which worker/index.test.ts holds to its `ROUTES`. Access stands in front, so nothing here signs
	// anyone in. See spec/architecture/console.md, "The UI is at the edge, the data is the nodes'".
	"assets": { "directory": "./build", "run_worker_first": ["/live", "/state", "/nearest"] },

	// `URLS.internal.console` in libs/sdk, which worker/index.test.ts holds this to. A custom domain,
	// so every deploy asserts it, as the gateway declares its apexes; see
	// spec/architecture/gateway.md, "The gateway declares its hosts in its `wrangler.jsonc`".
	"routes": [{ "pattern": "console.canmi.app", "custom_domain": true }],

	// Each node's Caddy, made by infra's `mise run tunnel` and bound by the node's name in capitals:
	// the list `hook` binds. worker/nodes.ts places each, and worker/index.test.ts holds the two
	// together.
	"vpc_services": [
		{ "binding": "RDU", "service_id": "01a0e5b1-1072-72d3-81cf-5b1c69ad7a6e", "remote": true },
		{ "binding": "TYO", "service_id": "01a10f21-8a27-7721-8223-54365d93b27b", "remote": true },
		{ "binding": "NRT", "service_id": "01a10f29-45f6-72f0-a7bd-1c86e3320a26", "remote": true },
		{ "binding": "HND", "service_id": "01a10f29-627a-7bf1-964b-4b0a660746d3", "remote": true },
		{ "binding": "GVX", "service_id": "01a10f29-7d17-7b80-90d1-800d9c078a39", "remote": true },
		{ "binding": "BRU", "service_id": "01a10f29-9169-7210-be9d-ad0a4de36833", "remote": true },
		{ "binding": "BUF", "service_id": "01a10f29-a4d0-78f2-b6da-cade48268370", "remote": true },
	],

	"observability": { "logs": { "enabled": true } },
	"workers_dev": false,
	"preview_urls": false,
}
