{
	"name": "@monoflake/console",
	"private": true,
	"description": "Every node at once, and where each is with what CI built.",
	"keywords": [
		"cloudflare-workers",
		"dashboard",
		"sveltekit",
		"websocket"
	],
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"prepare": "svelte-kit sync",
		"dev": "vite dev",
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"deploy": "vite build && wrangler deploy"
	},
	"devDependencies": {
		"@canmi/kit": "^2026.1005.5",
		"@canmi/response": "^2.0.0",
		"@cloudflare/workers-types": "^5.20261004.1",
		"@lucide/svelte": "^1.51.0",
		"@monoflake/sdk": "workspace:*",
		"@stylexjs/stylex": "^0.19.1",
		"@stylexjs/unplugin": "^0.19.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.2",
		"wrangler": "^4.147.0"
	}
}
