{
	"name": "@monoflake/gateway",
	"private": true,
	"description": "One entrance for every API.",
	"keywords": [
		"api",
		"cloudflare-workers",
		"gateway",
		"hono"
	],
	"type": "module",
	"scripts": {
		"dev": "node -e \"require('node:fs').rmSync('.wrangler/state/v3/cache', { recursive: true, force: true })\" && wrangler dev --env dev",
		"deploy": "wrangler deploy --env=\"\"",
		"build": "wrangler deploy --dry-run --outdir=dist --env=\"\""
	},
	"dependencies": {
		"@canmi/me": "^2026.1005.5",
		"@canmi/response": "^2.0.0",
		"@canmi/web": "^2026.1005.5",
		"@monoflake/sdk": "workspace:*",
		"hono": "^4.13.12"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261004.1",
		"smol-toml": "^1.9.0",
		"valibot": "^1.5.0",
		"wrangler": "^4.147.0"
	}
}
