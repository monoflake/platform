{
	// Everything that runs in neither runtime in particular, or in node. Type checking only: a
	// library here exports .ts straight from src and its consumers bundle it, so nothing emits.
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"lib": ["es2023", "dom"]
	},
	"include": ["apps/**/*.ts", "libs/**/*.ts", "*.ts"],
	"exclude": [
		"**/node_modules",
		"**/dist",
		"**/build",
		// Checked by tsconfig.workers.json against workerd's globals instead. Whole directories,
		// not just `src`: importing the worker is enough to pull it into this program.
		"libs/sdk/store",
		"apps/delivery/cdn",
		"apps/delivery/aka",
		"apps/edge/hook",
		"apps/edge/gateway",
		"apps/edge/quota"
	]
}
