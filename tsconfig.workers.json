{
	// The Workers and the code only they run -- libs/sdk/store speaks R2 and the asset fetcher. No
	// `dom`; see the workspace's spec/code.md, "A runtime's globals decide which program
	// checks a file".
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"lib": ["es2023"],
		// workerd's own globals arrive through each worker's worker-runtime.d.ts, not through
		// `types`: that field resolves from this directory, and the package is installed per
		// member. `node` is for the tests alone, and its globals are namespaced behind `node:`.
		"types": ["node"],
		"typeRoots": ["node_modules/@types"]
	},
	// A worker's tests belong here with it: they exercise worker code and mock worker bindings,
	// so checking them elsewhere drags the whole worker into a program with the browser's
	// globals. Tried, and that is what happened. `scripts/` is the node program and stays out.
	"include": [
		"apps/delivery/cdn/src/**/*.ts",
		"apps/delivery/cdn/*.d.ts",
		"apps/delivery/aka/src/**/*.ts",
		"apps/delivery/aka/*.d.ts",
		"apps/edge/hook/src/**/*.ts",
		"apps/edge/console/worker/**/*.ts",
		"apps/edge/hook/*.d.ts",
		"apps/edge/console/*.d.ts",
		"apps/edge/gateway/src/**/*.ts",
		"apps/edge/gateway/scripts/**/*.ts",
		"apps/edge/gateway/*.d.ts",
		"apps/edge/quota/src/**/*.ts",
		"apps/edge/quota/*.d.ts",
		"libs/sdk/store/src/**/*.ts",
		// Types, schemas and constants only, so neither carries a runtime global and both are
		// safe in this program and in the browser one at once.
		"libs/sdk/artifacts/src/**/*.ts",
		"libs/sdk/cache/src/**/*.ts"
	],
	"exclude": ["**/node_modules", "**/dist", "**/build"]
}
