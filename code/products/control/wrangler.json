{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "control",
	"main": "src/worker.res.mjs",
	"compatibility_date": "2026-10-21",
	"workers_dev": true,
	"preview_urls": false,
	"d1_databases": [
		{
			"binding": "STATE",
			"database_name": "control",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "control-artifacts" }],
	"vpc_networks": [{ "binding": "HOSTS", "network_id": "cf1:network" }],
	"vars": {
		"TUNNEL_API": "https://api.cloudflare.com/client/v4",
		"TUNNEL_ACCOUNT": ""
	},
	"env": {
		"local": {
			"d1_databases": [
				{
					"binding": "STATE",
					"database_name": "control",
					"database_id": "00000000-0000-0000-0000-000000000000",
					"migrations_dir": "migrations"
				}
			],
			"r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "control-artifacts" }],
			"vars": { "REACH": "localhost" }
		}
	}
}
