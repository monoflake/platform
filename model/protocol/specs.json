{
	"specs": [
		{
			"name": "overlap",
			"module": "overlap.tla",
			"quick": "overlap.cfg",
			"inputs": ["model/protocol/overlap.tla", "model/protocol/overlap.cfg"],
			"constants": {
				"command": ["node", "model/protocol/overlap_constants.res.mjs"],
				"inputs": ["model/protocol/overlap_constants.res.mjs", "model/protocol/window.res.mjs"]
			},
			"switches": [
				{ "name": "EXACT_RANGE", "breaks": "NoStuckDeploy" },
				{ "name": "DRIVER_OWN_VERSION_ONLY", "breaks": "NoStuckDeploy" },
				{ "name": "TWO_BEHIND", "breaks": "NoStuckDeploy" }
			],
			"export": {
				"command": ["node", "model/protocol/overlap_table.res.mjs", "{output}"],
				"file": "model/protocol/overlap-table.json",
				"checks": ["Table"],
				"inputs": ["model/protocol/overlap_table.res.mjs"]
			}
		},
		{
			"name": "footing",
			"module": "footing.tla",
			"quick": "footing.cfg",
			"inputs": ["model/protocol/footing.tla", "model/protocol/footing.cfg"],
			"constants": {
				"command": ["node", "model/protocol/footing_constants.res.mjs"],
				"inputs": [
					"model/protocol/footing_constants.res.mjs",
					"model/contracts/components/footings.res.mjs"
				]
			},
			"switches": [
				{ "name": "TAKE_BEFORE_PASSED", "breaks": "OneHolder" },
				{ "name": "CHECK_BEFORE_BATCH", "breaks": "PassedLeaseRefused" },
				{ "name": "STATEMENT_AT_A_TIME", "breaks": "AllOrNone" },
				{ "name": "PAGES_UNPINNED", "breaks": "WholeBatches" },
				{ "name": "NO_EXPIRY", "breaks": "TakenOver" }
			],
			"temporal": ["TakenOver"]
		},
		{
			"name": "storage",
			"module": "storage.tla",
			"quick": "storage.cfg",
			"inputs": ["model/protocol/storage.tla", "model/protocol/storage.cfg"],
			"switches": [
				{ "name": "NAME_BEFORE_CONTENT", "breaks": "NoNameWithoutContent" },
				{ "name": "DELETE_CONTENT", "breaks": "ContentHeld" },
				{ "name": "REPOINT_NAME", "breaks": "ObjectFixed" }
			],
			"export": {
				"command": ["node", "model/protocol/storage_runs.res.mjs", "{output}"],
				"file": "model/protocol/storage-runs.jsonl",
				"checks": ["Runs"],
				"inputs": ["model/protocol/storage_runs.res.mjs"]
			}
		}
	]
}
