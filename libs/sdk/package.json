			},
			"./symlink": {
				"types": "./dist/symlink/src/index.d.ts",
				"default": "./dist/symlink/src/index.js"
			}
		}
	},
	"scripts": {
		"build": "tsdown"
	},
	"dependencies": {
		"@canmi/me": "^2026.1004.4",
		"@canmi/response": "^2.0.0",
		"@monoflake/urls": "^2026.1004.3",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261004.1"
