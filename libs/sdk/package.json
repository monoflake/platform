{
	"name": "@monoflake/sdk",
	"version": "0.0.0",
	"description": "The platform's addresses, and every client of its services and its policies behind a subpath",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/monoflake/platform.git",
		"directory": "libs/sdk"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./artifacts": "./artifacts/src/index.ts",
		"./artifacts/types": "./artifacts/src/types.ts",
