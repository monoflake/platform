		"./imgsrc": "./imgsrc/src/index.ts",
		"./limits": "./limits/src/index.ts",
		"./robots": "./robots/src/index.ts",
		"./security": "./security/src/index.ts",
		"./security/agents": "./security/src/agents.ts",
		"./store": "./store/src/index.ts",
		"./symlink": "./symlink/src/index.ts"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/src/index.d.ts",
				"default": "./dist/src/index.js"
			},
			"./artifacts": {
				"types": "./dist/artifacts/src/index.d.ts",
				"default": "./dist/artifacts/src/index.js"
			},
			"./artifacts/types": {
				"types": "./dist/artifacts/src/types.d.ts",
				"default": "./dist/artifacts/src/types.js"
			},
			"./artifacts/anchors": {
				"types": "./dist/artifacts/src/anchors.d.ts",
				"default": "./dist/artifacts/src/anchors.js"
			},
			"./cache": {
				"types": "./dist/cache/src/index.d.ts",
				"default": "./dist/cache/src/index.js"
			},
			"./imgsrc": {
				"types": "./dist/imgsrc/src/index.d.ts",
				"default": "./dist/imgsrc/src/index.js"
			},
			"./limits": {
				"types": "./dist/limits/src/index.d.ts",
				"default": "./dist/limits/src/index.js"
			},
			"./robots": {
				"types": "./dist/robots/src/index.d.ts",
				"default": "./dist/robots/src/index.js"
			},
			"./security": {
				"types": "./dist/security/src/index.d.ts",
				"default": "./dist/security/src/index.js"
			},
			"./security/agents": {
				"types": "./dist/security/src/agents.d.ts",
