{
	"name": "@monoflake/probe",
	"version": "0.0.0",
	"description": "The status database's schema: the probe's records, as drizzle reads them",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/monoflake/platform.git",
		"directory": "libs/probe"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": "./src/schema.ts"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/src/schema.d.ts",
				"default": "./dist/src/schema.js"
			}
		}
	},
	"scripts": {
		"database:generate": "drizzle-kit generate",
		"check": "node scripts/check-migrations.ts",
		"build": "tsdown"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.3"
	},
	"devDependencies": {
		"drizzle-kit": "^0.31.11"
	}
}
