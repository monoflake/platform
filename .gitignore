# Dependencies, build output and caches stay out.

# Runtime state of the tasks that keep any: `lib-local`'s copies among them.
.local/

# Written by `mise run lib-local` alone, for a `[patch]` that points at the lib checkout beside
# this one; see .mise/tasks/lib-local.
.cargo/

# Bytecode cache for the Python mise tasks. Produced whenever one is imported rather than run.
__pycache__/

# pnpm falls back to a store here when it cannot reach ~/Library/pnpm -- a coding agent confined to
# the workspace is the case that produced it.
.pnpm-store/

node_modules/
build/
dist/
target/
.svelte-kit/
*.tsbuildinfo
coverage/

# Secrets: only secrets.json, encrypted, is committed. See the workspace's spec/toolchain.md.
.env
.env.*
!.env.example
*.age
keys.txt
age-key*.txt

.DS_Store

# Wrangler's local state, and what it generates for a Worker's types.
.wrangler/
worker-configuration.d.ts
