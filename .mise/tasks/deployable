#!/usr/bin/env python3
#MISE description="The images, or with --workers the Workers, a change needs rebuilt, as JSON: `deployable [--workers] [--all] [--since REV | --git BASE] [--files ...]`"
"""An app is deployable when its directory holds a `service.toml` and a `Dockerfile`, and needs a
new image when anything under that directory changed, a crate it is built from did, or the build
did. With `--workers`, the apps placed on `workers` with a `wrangler.jsonc` instead, each needing a
new `worker-` artifact when it, a package it imports, or the packaging changed. CI reads the list
to decide what to build; see infra's spec/architecture/host.md, "The machine pulls; nothing pushes
into it", and spec/architecture/deployer.md, "What a Worker artifact is"."""

import json
import subprocess
import sys
import tomllib
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from graph import ROOT, app_directories, app_of, build_inputs, changed, dependents, node_graph, owner, rust_graph  # noqa: E402

# How every image is built: a change here is a change to all of them.
EVERY_IMAGE = {"Cargo.toml", "Cargo.lock", ".dockerignore", ".mise/tasks/image"}
# How every Worker is packaged, the same.
EVERY_WORKER = {"package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml", ".mise/tasks/worker"}


def apps():
	"""App directory name -> its crate's name, for every app that declares an image."""
	found = {}
	for directory in app_directories().values():
		declaration = directory / "service.toml"
		if not declaration.exists() or not (directory / "Dockerfile").exists():
			continue
		manifest = declaration.parent / "Cargo.toml"
		name = declaration.parent.name
		for line in manifest.read_text().splitlines() if manifest.exists() else []:
			if line.startswith("name = "):
				name = line.split('"')[1]
				break
		found[declaration.parent.name] = name
	return found


def workers():
	"""App directory name -> its package's name, for every Workers app with a wrangler.jsonc."""
	found = {}
	for name, directory in app_directories().items():
		declaration = directory / "service.toml"
		if not declaration.exists() or not (directory / "wrangler.jsonc").exists():
			continue
		if "workers" not in tomllib.loads(declaration.read_text()).get("placements", []):
			continue
		manifest = directory / "package.json"
		found[name] = json.loads(manifest.read_text())["name"] if manifest.exists() else None
	return found


def git_changed(base):
	"""Files changed between `base` and HEAD, for CI, where there is git and no jj."""
	command = ["git", "diff", "--name-only", base, "HEAD"]
	output = subprocess.run(command, cwd=ROOT, capture_output=True, text=True, check=True).stdout
	return [line for line in output.splitlines() if line]


def needed(files, declared):
	if any(f in EVERY_IMAGE for f in files):
		return sorted(declared)
	# A file another crate includes is ignored here: every such include today is a test's, which
	# no image carries. A binary that embedded another crate's file would need it counted.
	crate_dirs, crate_edges, _included = rust_graph()
	built = build_inputs(crate_dirs)
	crates, chosen = set(), set()
	for f in files:
		crates |= built.get(owner(f, built) or f, set())
		if app_of(f) in declared:
			chosen.add(app_of(f))
		crate = crate_dirs.get(owner(f, crate_dirs) or "")
		if crate and (f.endswith(".rs") or f.endswith("/Cargo.toml")):
			crates.add(crate)
	reached = dependents(crates, crate_edges)
	chosen |= {app for app, crate in declared.items() if crate in reached}
	return sorted(chosen)


def needed_workers(files, declared):
	if any(f in EVERY_WORKER for f in files):
		return sorted(declared)
	package_dirs, package_edges = node_graph()
	packages, chosen = set(), set()
	for f in files:
		if app_of(f) in declared:
			chosen.add(app_of(f))
		package = package_dirs.get(owner(f, package_dirs) or "")
		if package:
			packages.add(package)
	reached = dependents(packages, package_edges)
	chosen |= {app for app, package in declared.items() if package in reached}
	return sorted(chosen)


def main():
	arguments = sys.argv[1:]
	worker = "--workers" in arguments
	declared = workers() if worker else apps()
	pick = needed_workers if worker else needed
	if "--all" in arguments:
		result = sorted(declared)
	elif "--files" in arguments:
		result = pick(arguments[arguments.index("--files") + 1 :], declared)
	elif "--git" in arguments:
		result = pick(git_changed(arguments[arguments.index("--git") + 1]), declared)
	else:
		since = arguments[arguments.index("--since") + 1] if "--since" in arguments else None
		result = pick(changed(since), declared)
	print(json.dumps(result))
	return 0


if __name__ == "__main__":
	sys.exit(main())
