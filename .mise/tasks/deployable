#!/usr/bin/env python3
#MISE description="The images, or with --workers the Workers, a change needs rebuilt, as JSON: `deployable [--workers] [--all] [--since REV | --git BASE [--head REV]] [--files ...]`"
"""An app is deployable when its directory holds a `service.toml` and a `Dockerfile`, and needs a
new image when what goes into it changed, each input read as a build reads it (see fingerprint.py):
a crate it is built from, a file its binary includes, a package Cargo.lock resolves it to, its
declaration, its Dockerfile, or the build; an app whose Dockerfile copies more than the workspace
takes every file in its directory. A comment or a reformat rebuilds nothing, so a panic's line and
`line!()` may lag the source. With `--workers`, the apps placed on `workers` with a `wrangler.jsonc`
instead, each needing a new `worker-` artifact when it, a package it imports, or the packaging
changed. CI reads the list to decide what to build; see infra's spec/architecture/host.md, "The
machine pulls; nothing pushes into it", and spec/architecture/deployer.md, "What a Worker artifact
is"."""

import atexit
import json
import shutil
import subprocess
import sys
import tempfile
import tomllib
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from fingerprint import ignored, normalized, same  # noqa: E402
from graph import ROOT, app_directories, app_of, build_inputs, changed, dependents, embedded, node_graph, owner, rust_graph  # noqa: E402
from resolved import lock_moved, manifest_moved, tree_moved  # noqa: E402

# How every image is built: a change here is a change to all of them.
EVERY_IMAGE = {".dockerignore", ".mise/tasks/image"}
# What every image is resolved from, read at both revisions so only the images whose inputs moved
# are rebuilt; see resolved.py. Given files alone, with no base to read, every image, as above.
RESOLUTION = {"Cargo.toml", "Cargo.lock"}
# What a Dockerfile copies from the context when its image is its crate's binary and nothing else.
WORKSPACE = {"Cargo.toml", "Cargo.lock", "apps", "libs"}
# How every Worker is packaged, the same.
EVERY_WORKER = {"package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml", ".mise/tasks/worker"}


def apps():
	"""App directory name -> its crate's name, for every app that declares an image."""
	found = {}
	for directory in app_directories().values():
		declaration = directory / "service.toml"
		if not declaration.exists() or not (directory / "Dockerfile").exists():
			continue
		manifest = declaration.parent / "Cargo.toml"
		name = declaration.parent.name
		for line in manifest.read_text().splitlines() if manifest.exists() else []:
			if line.startswith("name = "):
				name = line.split('"')[1]
				break
		found[declaration.parent.name] = name
	return found


def workers():
	"""App directory name -> its package's name, for every Workers app with a wrangler.jsonc."""
	found = {}
	for name, directory in app_directories().items():
		declaration = directory / "service.toml"
		if not declaration.exists() or not (directory / "wrangler.jsonc").exists():
			continue
		if "workers" not in tomllib.loads(declaration.read_text()).get("placements", []):
			continue
		manifest = directory / "package.json"
		found[name] = json.loads(manifest.read_text())["name"] if manifest.exists() else None
	return found


def git_changed(base, head="HEAD"):
	"""Files changed between `base` and `head`, for CI, where there is git and no jj."""
	command = ["git", "diff", "--name-only", base, head]
	output = subprocess.run(command, cwd=ROOT, capture_output=True, text=True, check=True).stdout
	return [line for line in output.splitlines() if line]


class Revision:
	"""One side of a comparison: the commit `commit` names, or the files on disk where it is None.
	Its whole tree is written out once, the first time cargo is asked about it."""

	def __init__(self, commit=None):
		self.commit, self.written = commit, None

	def read(self, path):
		if self.commit is None:
			file = ROOT / path
			return file.read_text() if file.exists() else None
		command = ["git", "show", f"{self.commit}:{path}"]
		answer = subprocess.run(command, cwd=ROOT, capture_output=True, text=True)
		return answer.stdout if answer.returncode == 0 else None

	def tree(self):
		if self.commit is None:
			return ROOT
		if self.written is None:
			self.written = Path(tempfile.mkdtemp(prefix="deployable-"))
			atexit.register(shutil.rmtree, self.written, True)
			command = ["git", "archive", self.commit]
			archive = subprocess.run(command, cwd=ROOT, capture_output=True, check=True).stdout
			subprocess.run(["tar", "-x", "-C", str(self.written)], input=archive, check=True)
		return self.written


def jj_commit(revision):
	"""The git commit a jj revision is, in this colocated repository."""
	command = ["jj", "log", "--no-graph", "-r", revision, "-T", "commit_id"]
	return subprocess.run(command, cwd=ROOT, capture_output=True, text=True, check=True).stdout


def resolution(files, declared, crate_dirs, revisions):
	"""The crates a change to Cargo.lock or the root Cargo.toml reaches, or None for every image:
	given no revisions to read, or where either file cannot be read or told apart. A crate the
	lockfile moves is asked of cargo, and kept where cargo cannot answer."""
	touched = RESOLUTION & set(files)
	if not touched:
		return set()
	if revisions is None:
		return None
	base, head = revisions
	moved = set()
	try:
		if "Cargo.lock" in touched:
			before, after = base.read("Cargo.lock"), head.read("Cargo.lock")
			if before is None or after is None:
				return None
			candidates = lock_moved(before, after, set(declared.values()))
			try:
				moved |= tree_moved(base.tree(), head.tree(), candidates, ROOT) if candidates else set()
			except (subprocess.CalledProcessError, OSError):
				moved |= candidates
		if "Cargo.toml" in touched:
			before, after = base.read("Cargo.toml"), head.read("Cargo.toml")
			if before is None or after is None:
				return None
			members = {
				crate: tomllib.loads((ROOT / directory / "Cargo.toml").read_text())
				for directory, crate in crate_dirs.items()
			}
			reached = manifest_moved(before, after, members)
			if reached is None:
				return None
			moved |= reached
	except (tomllib.TOMLDecodeError, KeyError, OSError):
		return None
	return moved


def copied(dockerfile):
	"""What `dockerfile` copies from the build's context, or None where it cannot be told: every
	source of a `COPY` or `ADD` without `--from`, but an address `ADD` fetches."""
	sources = set()
	for line in dockerfile.replace("\\\n", " ").splitlines():
		words = line.split()
		if not words or words[0].upper() not in ("COPY", "ADD"):
			continue
		if any(word.startswith("[") for word in words):
			return None
		if any(word.startswith("--from") for word in words):
			continue
		named = [word for word in words[1:] if not word.startswith("--")][:-1]
		sources |= {word for word in named if "://" not in word}
	return sources


def cargo_built(declared, crate_dirs):
	"""The apps whose image is their crate's binary alone: a crate of the workspace, with a
	Dockerfile copying nothing from the context but the workspace."""
	crates = set(crate_dirs.values())
	found = set()
	for app, directory in app_directories().items():
		if app not in declared or declared[app] not in crates:
			continue
		sources = copied((directory / "Dockerfile").read_text())
		if sources is not None and sources <= WORKSPACE:
			found.add(app)
	return found


def changes(files, crate_dirs, revisions):
	"""Those of `files` that change a build: not ignored and, with revisions to read them at, not
	the same once each is read as a build reads it."""
	kept = [f for f in files if not ignored(f, crate_dirs)]
	if revisions is None:
		return kept
	base, head = revisions
	return [f for f in kept if not normalized(f) or not same(f, base.read(f), head.read(f))]


def needed(files, declared, revisions=None):
	"""The apps `files` need rebuilt; `revisions` reads a file before and after, as (base, head)."""
	crate_dirs, crate_edges, _included = rust_graph()
	moving = changes(files, crate_dirs, revisions)
	if any(f in EVERY_IMAGE for f in moving):
		return sorted(declared)
	built = build_inputs(crate_dirs)
	# A file a binary includes outside its tests is that crate's source, and is in the binary byte
	# for byte, as is what a build script reads.
	carried = embedded(crate_dirs)
	crates, chosen = set(), set()
	for f in files:
		crates |= built.get(owner(f, built) or f, set())
		crates |= carried.get(f, set())
	binary = cargo_built(declared, crate_dirs)
	# A binary's declaration is read by host, not built into it, and still takes a new image here.
	inputs = ("/Dockerfile", "/service.toml")
	for f in moving:
		app = app_of(f)
		if app in declared and (app not in binary or f.endswith(inputs)):
			chosen.add(app)
		crate = crate_dirs.get(owner(f, crate_dirs) or "")
		if crate and (f.endswith(".rs") or f.endswith("/Cargo.toml")):
			crates.add(crate)
	moved = resolution(files, declared, crate_dirs, revisions)
	if moved is None:
		return sorted(declared)
	reached = dependents(crates | moved, crate_edges)
	chosen |= {app for app, crate in declared.items() if crate in reached}
	return sorted(chosen)


def needed_workers(files, declared, revisions=None):
	if any(f in EVERY_WORKER for f in files):
		return sorted(declared)
	package_dirs, package_edges = node_graph()
	packages, chosen = set(), set()
	for f in files:
		if app_of(f) in declared:
			chosen.add(app_of(f))
		package = package_dirs.get(owner(f, package_dirs) or "")
		if package:
			packages.add(package)
	reached = dependents(packages, package_edges)
	chosen |= {app for app, package in declared.items() if package in reached}
	return sorted(chosen)


def main():
	arguments = sys.argv[1:]
	worker = "--workers" in arguments
	declared = workers() if worker else apps()
	pick = needed_workers if worker else needed
	if "--all" in arguments:
		result = sorted(declared)
	elif "--files" in arguments:
		result = pick(arguments[arguments.index("--files") + 1 :], declared)
	elif "--git" in arguments:
		base = arguments[arguments.index("--git") + 1]
		head = arguments[arguments.index("--head") + 1] if "--head" in arguments else "HEAD"
		# HEAD is what CI checked out, so its tree is the one on disk.
		after = Revision(None if head == "HEAD" else head)
		result = pick(git_changed(base, head), declared, (Revision(base), after))
	else:
		since = arguments[arguments.index("--since") + 1] if "--since" in arguments else None
		files = changed(since)
		try:
			before = Revision(jj_commit(since or "@-"))
		except subprocess.CalledProcessError:
			before = None
		result = pick(files, declared, before and (before, Revision()))
	print(json.dumps(result))
	return 0


if __name__ == "__main__":
	sys.exit(main())
