#!/usr/bin/env python3
#MISE description="Run the platform's Postgres: `database env`, `database grant <scope> <app>`, `database switchover [node]`, `database quorum-auth`, `database mirror-env`, each with --dry-run"
"""The operator's half of the platform's Postgres. See spec/architecture/databases.md.

`env` writes what the database and its etcd, `quorum`, read on each node, `grant` gives an app its
database and login and writes its `DATABASE_URL`, and `switchover` asks Patroni to move the leader,
to the node named or to the one it chooses; `quorum-auth` turns etcd's password on, once;
`mirror-env` gives each node's `store` the key it reads the backups with. Values move over SSH on
stdin, never on a command line, and `--dry-run` touches no machine and prints no secret.
"""

import base64
import json
import os
import re
import secrets
import shlex
import subprocess
import sys
import tempfile
import time
import tomllib
import urllib.error
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
REPOS = ROOT.parent
NODES = REPOS / "infra/nodes/nodes.toml"
APP = "database"
SERVICE = ROOT / "apps/data/database/service.toml"
# Where its image is built, which a deploy by hand names. See spec/architecture/databases.md,
# "Upgrades are pinned, reported, and rolled by hand".
REPOSITORY = "monoflake/platform"
# Patroni's failover priorities, first highest, each named by hand; a member not named here, `gvx`
# or `sha`, never leads. See spec/architecture/databases.md, "Where it runs, and which one writes".
ORDER = ["tyo", "rdu", "buf"]
PORT = 5432
# Patroni's REST on each member, and etcd's client and peer ports on each core.
REST = 8008
ETCD_CLIENT = 2379
ETCD_PEER = 2380
QUORUM = "quorum"
# The proxy every app reaches the database through, as `primary:5432`, on every node.
PROXY = "primary"
REST_USER = "patroni"
# The scopes there are, each an organization. See spec/architecture/scheduling.md, "A scope is an
# organization, and only the boundary isolates".
SCOPES = ("platform", "canmi")
# secrets.json's name for each value the keeper reads, made once when absent.
MADE = {
	"POSTGRES_PASSWORD": "DATABASE_SUPERUSER_PASSWORD",
	"REPLICATION_PASSWORD": "DATABASE_REPLICATION_PASSWORD",
	"WALG_LIBSODIUM_KEY": "DATABASE_BACKUP_KEY",
	"PATRONI_PASSWORD": "DATABASE_PATRONI_PASSWORD",
}
# etcd's own root, which only `quorum-auth` uses.
QUORUM_ROOT = "QUORUM_ROOT_PASSWORD"
# The members of etcd prove themselves to each other by certificate on the peer port: a CA of
# their own and a certificate for each, kept in secrets.json and written into each member's
# directory, where the container reads them at /data/tls. See spec/todo/todo.md, "The database".
QUORUM_CA = ("QUORUM_CA_CERT", "QUORUM_CA_KEY")
QUORUM_TLS = "data/tls"
QUORUM_USER = "65532:65532"
CERTIFICATE_DAYS = 3650
# The backup store, by secrets.json's names, and the names WAL-G reads them under.
STORE = {
	"BACKUP_S3_ENDPOINT": "AWS_ENDPOINT",
	"BACKUP_S3_REGION": "AWS_REGION",
	"BACKUP_S3_ACCESS_KEY_ID": "AWS_ACCESS_KEY_ID",
	"BACKUP_S3_SECRET_ACCESS_KEY": "AWS_SECRET_ACCESS_KEY",
}
BUCKET = "BACKUP_S3_BUCKET"
# What each node's `store` mirrors the backups with: the store's place, by the same names, and a key
# that may list and read its bucket and nothing more. See spec/architecture/databases.md, "Backups
# are the data, kept off the cluster".
MIRROR = "store"
MIRRORED = [
	"BACKUP_S3_ENDPOINT",
	"BACKUP_S3_REGION",
	BUCKET,
	"BACKUP_MIRROR_S3_ACCESS_KEY_ID",
	"BACKUP_MIRROR_S3_SECRET_ACCESS_KEY",
]
# How long a switchover may take to show its new leader running.
SWITCHING_SECONDS = 60
LABEL = re.compile(r"^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$")

# Runs on the node with KEY=VALUE lines on stdin and the app's directory and the file's name as
# arguments: each key is set, every other line kept, the file root's alone. Prints current or
# changed.
UPSERT = r"""set -eu
umask 077
dir=$1
file=$dir/$2
mountpoint -q /data || { echo "/data is not mounted" >&2; exit 1; }
mkdir -p /data/apps
[ -d "$dir" ] || btrfs subvolume create "$dir" >/dev/null
chmod 700 "$dir"
cp -p "$file" "$file.new" 2>/dev/null || : > "$file.new"
while IFS= read -r pair; do
	[ -n "$pair" ] || continue
	K=${pair%%=*} V=${pair#*=} awk 'BEGIN { k = ENVIRON["K"]; v = ENVIRON["V"] }
		index($0, k "=") == 1 { if (!d) print k "=" v; d = 1; next }
		{ print }
		END { if (!d) print k "=" v }' "$file.new" > "$file.tmp"
	mv "$file.tmp" "$file.new"
done
if [ -f "$file" ] && cmp -s "$file.new" "$file"; then
	rm -f "$file.new"
	echo current
else
	chown root:root "$file.new"
	chmod 600 "$file.new"
	mv "$file.new" "$file"
	echo changed
fi
"""


def fail(message):
	sys.exit(f"database: {message}")


def ssh(node, command, stdin=None):
	"""What the command printed, or None when it failed; its errors go to the terminal."""
	result = subprocess.run(
		["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", f"root@{node}", command],
		input=stdin,
		text=True,
		stdout=subprocess.PIPE,
	)
	return result.stdout.strip() if result.returncode == 0 else None


def upsert(node, app, file, pairs):
	"""Sets `pairs` in /data/apps/<app>/<file> on `node`; True when it was written or already was."""
	command = f"sh -c {shlex.quote(UPSERT)} sh {shlex.quote(f'/data/apps/{app}')} {shlex.quote(file)}"
	answer = ssh(node, command, "".join(f"{key}={value}\n" for key, value in pairs.items()))
	if answer is None:
		print(f"database: {node}: writing /data/apps/{app}/{file} failed")
		return False
	print(f"database: {node}: /data/apps/{app}/{file} {answer}")
	return True


def tailnet_ipv4(name):
	found = subprocess.run(["tailscale", "ip", "-4", name], text=True, stdout=subprocess.PIPE)
	address = found.stdout.split()[0] if found.returncode == 0 and found.stdout.split() else None
	if address is None:
		fail(f"tailscale has no IPv4 for {name}")
	return address


def stored_secret(key, dry):
	"""`key` from secrets.json, made and stored there first when it is not."""
	if os.environ.get(key):
		return os.environ[key]
	if dry:
		print(f"database: {key} is not in secrets.json; 32 random bytes would be stored there as it")
		return None
	value = secrets.token_hex(32)
	stored = subprocess.run(
		["sops", "set", "--value-stdin", "secrets.json", json.dumps([key])],
		input=json.dumps(value),
		text=True,
		cwd=ROOT,
	)
	if stored.returncode != 0:
		fail(f"storing {key} in secrets.json failed")
	print(f"database: {key} was made and stored in secrets.json")
	return value


def placements():
	"""The core nodes the database runs on, from its service.toml."""
	return tomllib.loads(SERVICE.read_text())["placements"]


def cluster(addresses):
	"""Patroni's view of the cluster from the first member whose REST answers, or None."""
	for host in addresses.values():
		try:
			with urllib.request.urlopen(f"http://{host}:{REST}/cluster", timeout=5) as answer:
				return json.load(answer)
		except (OSError, ValueError):
			continue
	return None


def leader_of(view):
	return next((m["name"] for m in view.get("members", []) if m.get("role") == "leader"), None)


def shown(view):
	return "  ".join(
		f"{m['name']}: {m.get('role')} {m.get('state')} tl{m.get('timeline', '-')}"
		for m in view.get("members", [])
	)


def env(arguments, dry):
	if arguments:
		fail("env takes no arguments")
	nodes = placements()
	cores = manifest_of(QUORUM)["placements"]
	if not set(ORDER) <= set(nodes) or not set(cores) <= set(nodes):
		fail(f"ORDER, {', '.join(ORDER)}, and {QUORUM}'s members must be among {', '.join(nodes)}")
	missing = [key for key in [*STORE, BUCKET] if not os.environ.get(key)]
	if missing:
		message = f"secrets.json has no {', '.join(missing)}; add them with sops and run again"
		if not dry:
			fail(message)
		print(f"database: {message} (a real run stops here)")

	addresses = {node: tailnet_ipv4(node) for node in nodes}
	peers = " ".join(f"{node}={address}" for node, address in addresses.items())
	made = {name: stored_secret(key, dry) for name, key in MADE.items()}
	stored_secret(QUORUM_ROOT, dry)
	store = {name: os.environ.get(key) for key, name in STORE.items()}
	store["WALG_S3_PREFIX"] = f"s3://{os.environ.get(BUCKET, '<bucket>')}/{APP}"
	members = ",".join(f"{node}=https://{addresses[node]}:{ETCD_PEER}" for node in cores)
	certificates = quorum_tls(cores, addresses, dry)
	quorum_hosts = " ".join(addresses[node] for node in cores)

	failed = []
	for node in nodes:
		address = addresses[node]
		priority = len(ORDER) - ORDER.index(node) if node in ORDER else 0
		config = {
			"DATABASE_PEERS": peers,
			"DATABASE_QUORUM": quorum_hosts,
			"DATABASE_PRIORITY": str(priority),
		}
		quorum = {
			"ETCD_NAME": node,
			"ETCD_INITIAL_ADVERTISE_PEER_URLS": f"https://{address}:{ETCD_PEER}",
			"ETCD_ADVERTISE_CLIENT_URLS": f"http://{address}:{ETCD_CLIENT}",
			"ETCD_INITIAL_CLUSTER": members,
		} if node in cores else None
		if dry:
			print(
				f"database: {node}: would, on root@{node}, make"
				f" {' and '.join(f'/data/apps/{a}' for a in [APP, QUORUM][: 2 if quorum else 1])}"
				f" unless there, mode 700, and set, keeping every other line, mode 600:\n"
				f"  {APP}/config.env: {' '.join(f'{k}={v!r}' for k, v in config.items())}\n"
				f"  {APP}/secret.env: {' '.join(f'{k}=<redacted>' for k in [*made, *STORE.values()])}"
				f" WALG_S3_PREFIX={store['WALG_S3_PREFIX']}"
				+ (
					f"\n  {QUORUM}/config.env: {' '.join(f'{k}={v}' for k, v in (quorum or {}).items())}"
					f"\n  {QUORUM}/{QUORUM_TLS}/: ca.crt, peer.crt, peer.key, mode 600, {QUORUM_USER}'s"
				)
				* bool(quorum)
			)
			continue
		if not (
			upsert(node, APP, "config.env", config)
			and upsert(node, APP, "secret.env", made | store)
			and (quorum is None or upsert(node, QUORUM, "config.env", quorum))
			and (quorum is None or write_tls(node, certificates[node]))
		):
			failed.append(node)
	# The proxy on every node asks each member's REST which is primary; it needs no password.
	proxy = {"PRIMARY_MEMBERS": peers, "PRIMARY_REST_PORT": str(REST)}
	for node in manifest_of(PROXY)["placements"]:
		if dry:
			shown_proxy = " ".join(f"{k}={v!r}" for k, v in proxy.items())
			print(f"database: {node}: would set in /data/apps/{PROXY}/config.env: {shown_proxy}")
		elif not upsert(node, PROXY, "config.env", proxy):
			failed.append(node)
	if failed:
		fail(f"failed on {', '.join(failed)}")
	if not os.environ.get(MADE["WALG_LIBSODIUM_KEY"]) and not dry:
		print(
			f"database: {MADE['WALG_LIBSODIUM_KEY']} is new: keep a copy beside secrets.json somewhere a"
			" lost laptop does not take with it, or no backup can be read"
		)
	print(
		f"database: a change applies on the next deploy; `mise run //repos/infra:node redeploy <node>"
		f" {APP}` or `{QUORUM}`, a member at a time. A run deploys neither, so a new version is by"
		f" hand:\n"
		f"  mise run //repos/infra:node deploy <node> --run <run> --repository {REPOSITORY} --app <app>"
	)


def manifest_of(app):
	"""The service.toml naming `app`, in any repository beside this one."""
	for path in sorted(REPOS.glob("*/apps/**/service.toml")):
		if "node_modules" in path.parts:
			continue
		declared = tomllib.loads(path.read_text())
		if declared.get("name") == app:
			return declared
	fail(f"no service.toml in {REPOS} names {app}")


def ident(name):
	return '"' + name.replace('"', '""') + '"'


def literal(value):
	return "'" + value.replace("'", "''") + "'"


def grant_sql(scope, login, password):
	"""The scope's role, the app's login inside it, and its database, which the scope owns and
	nobody outside it may connect to. Run again it changes nothing but the password, to the one
	given. See spec/architecture/databases.md, "One cluster, and a scope is a role in it"."""
	return "\n".join(
		[
			# Its password would be logged by `log_statement = ddl` otherwise.
			"SET log_statement = 'none';",
			f"SELECT format('CREATE ROLE %I NOLOGIN', {literal(scope)}) WHERE NOT EXISTS"
			f" (SELECT FROM pg_roles WHERE rolname = {literal(scope)})\\gexec",
			f"SELECT format('CREATE ROLE %I LOGIN', {literal(login)}) WHERE NOT EXISTS"
			f" (SELECT FROM pg_roles WHERE rolname = {literal(login)})\\gexec",
			f"ALTER ROLE {ident(login)} WITH LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION"
			f" PASSWORD {literal(password)};",
			f"GRANT {ident(scope)} TO {ident(login)};",
			# What the app makes is the scope's, as its database is.
			f"ALTER ROLE {ident(login)} SET role = {literal(scope)};",
			f"SELECT format('CREATE DATABASE %I OWNER %I', {literal(login)}, {literal(scope)}) WHERE NOT"
			f" EXISTS (SELECT FROM pg_database WHERE datname = {literal(login)})\\gexec",
			f"ALTER DATABASE {ident(login)} OWNER TO {ident(scope)};",
			f"REVOKE ALL ON DATABASE {ident(login)} FROM PUBLIC;",
			"",
		]
	)


def secret_key(scope, app):
	return f"DATABASE_PASSWORD_{scope}_{app}".upper().replace("-", "_")


def grant(arguments, dry):
	names = [a for a in arguments if not a.startswith("-")]
	if len(names) != 2 or names[0] not in SCOPES or not LABEL.match(names[1]):
		fail(f"grant takes a scope, one of {', '.join(SCOPES)}, and an app's name")
	scope, app = names
	login = f"{scope}_{app.replace('-', '_')}"
	known = set(tomllib.loads(NODES.read_text()))
	where = [node for node in manifest_of(app)["placements"] if node in known]
	cores = placements()
	primary = None
	if not dry:
		view = cluster({node: tailnet_ipv4(node) for node in cores})
		primary = view and leader_of(view)
		if primary is None:
			fail("no member's Patroni names a leader now; grant once one leads")
	password = stored_secret(secret_key(scope, app), dry)

	if dry:
		shown = grant_sql(scope, login, "<redacted>")
		print(
			f"database: would, on the leader Patroni names, by its REST on {REST},"
			f" run in the {APP} container, {login}'s password from {secret_key(scope, app)}:\n"
			f"{shown}"
			f"database: and set in /data/apps/{app}/secret.env on {', '.join(where) or 'no node'}:\n"
			f"  DATABASE_URL=postgresql://{login}:<redacted>@{PROXY}:{PORT}/{login}"
			"?target_session_attrs=read-write"
		)
		return
	command = f"docker exec -i {APP} psql --no-psqlrc --quiet --set=ON_ERROR_STOP=1"
	if ssh(primary, command, grant_sql(scope, login, password)) is None:
		fail(f"granting on {primary} failed")
	print(f"database: {primary}: {login} logs in to {login}, owned by {scope}")
	# The proxy on the app's own node, which follows the primary, so a failover rewrites no URL;
	# the attribute still refuses a replica, should the proxy ever pass to one. See
	# spec/todo/todo.md, "The database".
	url = f"postgresql://{login}:{password}@{PROXY}:{PORT}/{login}?target_session_attrs=read-write"
	failed = [node for node in where if not upsert(node, app, "secret.env", {"DATABASE_URL": url})]
	if failed:
		fail(f"writing DATABASE_URL failed on {', '.join(failed)}")
	print(f"database: {app} reads it on its next deploy")


def switchover_to(addresses, password, node, dry):
	"""Patroni's switchover from the leader to `node`, or to the member Patroni chooses by its
	priorities when `node` is None, then waited on until the new leader runs."""
	if dry:
		to = f"to {node}" if node else "to the member its priorities choose"
		print(
			f"database: would read the cluster from the first member whose REST on {REST} answers,"
			f" then ask the leader's to switch over {to}, as {REST_USER}, and wait up to"
			f" {SWITCHING_SECONDS} seconds for the new leader to run"
		)
		return
	view = cluster(addresses)
	if view is None:
		fail("no member's Patroni answered")
	leader = leader_of(view)
	print(f"database: now {shown(view)}")
	if leader is None:
		fail("the cluster has no leader now; Patroni elects one by itself")
	if node == leader:
		print(f"database: {node} leads already")
		return
	body = {"leader": leader} | ({"candidate": node} if node else {})
	token = base64.b64encode(f"{REST_USER}:{password}".encode()).decode()
	request = urllib.request.Request(
		f"http://{addresses[leader]}:{REST}/switchover",
		data=json.dumps(body).encode(),
		method="POST",
		headers={"Content-Type": "application/json", "Authorization": f"Basic {token}"},
	)
	try:
		with urllib.request.urlopen(request, timeout=SWITCHING_SECONDS) as answer:
			print(f"database: {leader}'s Patroni: {answer.read().decode().strip()}")
	except urllib.error.HTTPError as refused:
		fail(f"{leader}'s Patroni refused: {refused.code} {refused.read().decode().strip()}")
	except OSError as error:
		fail(f"{leader}'s Patroni did not answer: {error}")
	for _ in range(SWITCHING_SECONDS):
		view = cluster(addresses) or {}
		now = leader_of(view)
		if now and now != leader and (node is None or now == node):
			if any(m["name"] == now and m.get("state") == "running" for m in view["members"]):
				print(f"database: {now} leads; {shown(view)}")
				return
		time.sleep(1)
	fail(f"no new leader ran within {SWITCHING_SECONDS}s; `patronictl list` on a member says why")


def switchover(arguments, dry):
	nodes = placements()
	names = [a for a in arguments if not a.startswith("-")]
	if len(names) > 1 or (names and names[0] not in nodes):
		fail(f"switchover takes one of {', '.join(nodes)}, or none for the one Patroni chooses")
	password = os.environ.get(MADE["PATRONI_PASSWORD"])
	if not password and not dry:
		fail(f"secrets.json has no {MADE['PATRONI_PASSWORD']}; `database env` makes it")
	addresses = {} if dry else {node: tailnet_ipv4(node) for node in nodes}
	switchover_to(addresses, password, names[0] if names else None, dry)


def openssl(directory, *args):
	"""openssl in `directory`, every key and certificate a file there, never an argument."""
	done = subprocess.run(["openssl", *args], cwd=directory, text=True, capture_output=True)
	if done.returncode != 0:
		fail(f"openssl {args[0]} failed: {done.stderr.strip()}")
	return done.stdout


GENPKEY = ("genpkey", "-algorithm", "EC", "-pkeyopt", "ec_paramgen_curve:P-256", "-out")


def make_ca():
	"""A CA of etcd's own members, its key and certificate as PEM."""
	with tempfile.TemporaryDirectory() as directory:
		Path(directory, "ca.cnf").write_text(
			"[req]\ndistinguished_name=dn\n[dn]\n[ext]\nbasicConstraints=critical,CA:TRUE\n"
			"keyUsage=critical,keyCertSign,cRLSign\n"
		)
		openssl(directory, *GENPKEY, "ca.key")
		openssl(
			directory, "req", "-x509", "-new", "-key", "ca.key", "-subj", f"/CN={QUORUM}-ca",
			"-days", str(CERTIFICATE_DAYS), "-config", "ca.cnf", "-extensions", "ext", "-out", "ca.crt",
		)
		return Path(directory, "ca.crt").read_text(), Path(directory, "ca.key").read_text()


def make_peer(ca, node, address):
	"""A member's key and certificate, signed by `ca`, naming the member and its tailnet address,
	good for both ends of a peer connection."""
	with tempfile.TemporaryDirectory() as directory:
		Path(directory, "ca.crt").write_text(ca[0])
		Path(directory, "ca.key").write_text(ca[1])
		Path(directory, "req.cnf").write_text("[req]\ndistinguished_name=dn\n[dn]\n")
		Path(directory, "peer.ext").write_text(
			f"subjectAltName=IP:{address},DNS:{node}\nextendedKeyUsage=serverAuth,clientAuth\n"
			"keyUsage=critical,digitalSignature,keyEncipherment\n"
		)
		openssl(directory, *GENPKEY, "peer.key")
		openssl(
			directory, "req", "-new", "-key", "peer.key", "-subj", f"/CN={node}", "-config", "req.cnf",
			"-out", "peer.csr",
		)
		openssl(
			directory, "x509", "-req", "-in", "peer.csr", "-CA", "ca.crt", "-CAkey", "ca.key",
			"-CAcreateserial", "-days", str(CERTIFICATE_DAYS), "-extfile", "peer.ext", "-out", "peer.crt",
		)
		return Path(directory, "peer.crt").read_text(), Path(directory, "peer.key").read_text()


def names(certificate):
	"""The names and addresses a certificate is for."""
	with tempfile.TemporaryDirectory() as directory:
		Path(directory, "peer.crt").write_text(certificate)
		text = openssl(directory, "x509", "-in", "peer.crt", "-noout", "-ext", "subjectAltName")
	return {part.split(":", 1)[1] for part in re.split(r"[,\s]+", text) if ":" in part} - {""}


def store_secret(key, value):
	stored = subprocess.run(
		["sops", "set", "--value-stdin", "secrets.json", json.dumps([key])],
		input=json.dumps(value),
		text=True,
		cwd=ROOT,
	)
	if stored.returncode != 0:
		fail(f"storing {key} in secrets.json failed")
	os.environ[key] = value
	print(f"database: {key} was made and stored in secrets.json")


def quorum_tls(cores, addresses, dry):
	"""Each member's CA, certificate and key, made once and kept in secrets.json; a member's is made
	again when its address is no longer one its certificate names."""
	ca = tuple(os.environ.get(key) for key in QUORUM_CA)
	if not all(ca):
		if dry:
			print(f"database: would make a CA for {QUORUM}'s peers, stored as {' and '.join(QUORUM_CA)}")
			return {node: None for node in cores}
		ca = make_ca()
		for key, value in zip(QUORUM_CA, ca):
			store_secret(key, value)
	certificates = {}
	for node in cores:
		keys = (f"QUORUM_PEER_CERT_{node.upper()}", f"QUORUM_PEER_KEY_{node.upper()}")
		peer = tuple(os.environ.get(key) for key in keys)
		if not all(peer) or addresses[node] not in names(peer[0]):
			if dry:
				print(f"database: would make {node}'s peer certificate for {addresses[node]} and store it")
				certificates[node] = None
				continue
			peer = make_peer(ca, node, addresses[node])
			for key, value in zip(keys, peer):
				store_secret(key, value)
		certificates[node] = {"ca.crt": ca[0], "peer.crt": peer[0], "peer.key": peer[1]}
	return certificates


# Writes stdin to a file in the member's directory, its own, mode 600, created whole or not at all.
WRITE_FILE = r"""set -eu
umask 077
dir=$1
mkdir -p "$dir"
cat > "$dir/$2.new"
chown "$3" "$dir" "$dir/$2.new"
mv "$dir/$2.new" "$dir/$2"
"""


def write_tls(node, files):
	directory = f"/data/apps/{QUORUM}/{QUORUM_TLS}"
	for name, content in files.items():
		command = f"sh -c {shlex.quote(WRITE_FILE)} sh {shlex.quote(directory)} {name} {QUORUM_USER}"
		if ssh(node, command, content) is None:
			print(f"database: {node}: writing {directory}/{name} failed")
			return False
	print(f"database: {node}: {directory} holds its CA, certificate and key")
	return True


def quorum_auth_steps(root, patroni):
	"""etcdctl's arguments and what each reads on stdin: a root holding the root role, a role
	reaching the database's keys alone, Patroni's user in it, then authentication on. Passwords go
	on stdin alone."""
	return [
		(["user", "add", "root", "--interactive=false"], root),
		(["user", "grant-role", "root", "root"], None),
		(["role", "add", REST_USER], None),
		(["role", "grant-permission", REST_USER, "readwrite", "--prefix=true", "/database/"], None),
		(["user", "add", REST_USER, "--interactive=false"], patroni),
		(["user", "grant-role", REST_USER, REST_USER], None),
		(["auth", "enable"], None),
	]


def quorum_auth(arguments, dry):
	"""etcd's password turned on, once, on the first core: a member that already asks one is left
	as it is. See spec/todo/todo.md, "The database"."""
	if arguments:
		fail("quorum-auth takes no arguments")
	core = manifest_of(QUORUM)["placements"][0]
	# Its default endpoint is the member beside it.
	etcdctl = f"docker exec -i {QUORUM} etcdctl"
	if dry:
		print(f"database: would, on root@{core}, unless etcd already asks a password:")
		for args, stdin in quorum_auth_steps("<redacted>", "<redacted>"):
			print(f"  {etcdctl} {' '.join(args)}" + (" < password" if stdin else ""))
		return
	status = ssh(core, f"{etcdctl} auth status")
	if status is None:
		fail(f"etcd on {core} did not answer; deploy {QUORUM} on its members first")
	if "true" in status.lower():
		print(f"database: etcd on {core} already asks a password")
		return
	root = stored_secret(QUORUM_ROOT, dry)
	patroni = os.environ.get(MADE["PATRONI_PASSWORD"])
	if not patroni:
		fail(f"secrets.json has no {MADE['PATRONI_PASSWORD']}; `database env` makes it")
	for args, stdin in quorum_auth_steps(root, patroni):
		if ssh(core, f"{etcdctl} {' '.join(shlex.quote(a) for a in args)}", stdin) is None:
			fail(f"etcdctl {' '.join(args)} failed on {core}")
	print(f"database: etcd asks a password now; Patroni signs in as {REST_USER}")


def mirror_env(arguments, dry):
	if arguments:
		fail("mirror-env takes no arguments")
	known = set(tomllib.loads(NODES.read_text()))
	where = [node for node in manifest_of(MIRROR)["placements"] if node in known]
	missing = [key for key in MIRRORED if not os.environ.get(key)]
	if missing:
		message = f"secrets.json has no {', '.join(missing)}; add them with `mise run secret`"
		if not dry:
			fail(message)
		print(f"database: {message} (a real run stops here)")
	for node in where:
		if dry:
			print(
				f"database: {node}: would set, keeping every other line, mode 600, in"
				f" /data/apps/{MIRROR}/secret.env: {' '.join(f'{key}=<redacted>' for key in MIRRORED)}"
			)
		elif not upsert(node, MIRROR, "secret.env", {key: os.environ[key] for key in MIRRORED}):
			fail(f"writing the mirror's key failed on {node}")
	print(
		f"database: {MIRROR} reads it on its next deploy;"
		f" `mise run //repos/infra:node redeploy <node> {MIRROR}`"
	)


def main():
	arguments = sys.argv[1:]
	dry = "--dry-run" in arguments or "-n" in arguments
	rest = [a for a in arguments[1:] if a not in ("--dry-run", "-n")]
	verbs = {
		"env": env,
		"grant": grant,
		"switchover": switchover,
		"quorum-auth": quorum_auth,
		"mirror-env": mirror_env,
	}
	if not arguments or arguments[0] not in verbs:
		fail(
			"name one of env, grant <scope> <app>, switchover [node], quorum-auth or mirror-env, and"
			" --dry-run to only say what"
		)
	verbs[arguments[0]](rest, dry)


if __name__ == "__main__":
	main()
