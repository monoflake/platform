#!/usr/bin/env bash
#MISE description="Build an app's image as an archive: `image <name> <path>`"
set -euo pipefail

# The one way an image is built, by `mise run host deploy` here and by CI on GitHub, so the two
# cannot build different things. The platform is the machine at home's; PLATFORM overrides it.
name="${1:?usage: image <name> <path>}"
archive="${2:?usage: image <name> <path>}"
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"

# The compiler every check runs, from the toolchain file the workspace holds above this
# repository -- read as a file, so a machine need not install the toolchain to learn its version.
dir="$ROOT"
while [ "$dir" != / ] && [ ! -f "$dir/rust-toolchain.toml" ]; do dir="$(dirname "$dir")"; done
version="$(sed -n 's/^channel = "\(.*\)"/\1/p' "$dir/rust-toolchain.toml" 2>/dev/null || true)"
[ -n "$version" ] || { echo "image: no rust-toolchain.toml above $ROOT" >&2; exit 1; }

# Node's major, for an image that builds a page, from the `[tools]` the workspace pins it in.
dir="$ROOT"
while [ "$dir" != / ] && ! grep -qs '^node = "' "$dir/mise.toml"; do dir="$(dirname "$dir")"; done
node="$(sed -n 's/^node = "\(.*\)"/\1/p' "$dir/mise.toml" 2>/dev/null || true)"
[ -n "$node" ] || { echo "image: no node in a mise.toml above $ROOT" >&2; exit 1; }

app="$(find "$ROOT/apps" -mindepth 2 -maxdepth 2 -type d -name "$name" | head -n 1)"
[ -n "$app" ] || { echo "image: no app named $name" >&2; exit 1; }

# sccache's backend is what this environment names, SCCACHE_GHA_ENABLED in CI, handed in as the
# secret `sccache` with the credentials it reads; with none, each build caches on a mount of its
# own. See infra's spec/architecture/host.md, "An image is built for speed, and for any node of its
# architecture".
forward=""
for key in $(compgen -e | grep '^SCCACHE_' | grep -vx SCCACHE_DIR) \
	ACTIONS_RESULTS_URL ACTIONS_RUNTIME_TOKEN ACTIONS_CACHE_SERVICE_V2; do
	[ -n "${!key:-}" ] || continue
	quote="'\\''"
	forward+="export $key='${!key//\'/$quote}'"$'\n'
done
secret=()
[ -z "$forward" ] || secret=(--secret id=sccache,env=SCCACHE_FORWARD)

SCCACHE_FORWARD="$forward" docker buildx build --platform "${PLATFORM:-linux/arm64}" \
	--file "$app/Dockerfile" ${secret[@]+"${secret[@]}"} \
	--build-arg "RUST_VERSION=$version" --build-arg "NODE_VERSION=$node" \
	--tag "$name:local" --output "type=docker,dest=$archive" "$ROOT"
