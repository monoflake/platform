		{
			"description": "content put is read whole and by range, described, listed and deleted",
			"steps": [
				{
					"call": "put",
					"input": {
						"space": "storage",
						"placement": {
							"availability": "best_effort",
							"durability": "persistent",
							"custody": "false"
						},
						"content": "aGVsbG8"
					},
					"expect": {
						"output": {
							"hash": {
								"$capture": "a"
							},
							"size": 5
						}
					}
				},
				{
					"call": "get",
					"input": {
						"space": "storage",
						"hash": {
							"$use": "a"
