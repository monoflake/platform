						"output": {
							"content": "aGVsbG8",
							"size": 5
						}
					}
				},
				{
					"call": "get",
					"input": {
						"space": "storage",
						"hash": {
							"$use": "a"
						},
						"range": {
							"start": 1,
							"length": 3
						}
					},
					"expect": {
						"output": {
							"content": "ZWxs",
							"size": 5
						}
					}
				},
