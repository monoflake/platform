{
	"from": "RFC vuanj: a scope's status and allowance read from its organization's bundle, the issuer section's `bundle-issuer`, its status `active` where absent; RFC kd7f9: a need fits by vocabulary*'s `fits` over the model's vocabulary, defaults filled and every failing capability named; a scope not active fails as `scope-status` names it; RFC b8hyu for a scope the bundle does not hold. Each bundle holds its issuer section as JSON, written to its CBOR by the test, or as hex where it is malformed",
	"held": [
		{
			"what": "an active scope given tcp and instance, a need within it fitting",
			"bundle": {
				"scope": 7,
				"generation": 3,
				"issuer": {
					"grants": [],
					"allowance": {
						"network": { "name": "some", "values": ["http", "tcp"] },
						"instance": { "name": "flag", "value": true }
					},
					"security": "default",
					"status": "active"
				}
			},
			"scope": 7,
			"status": "active",
			"allowance": {
				"kind": { "name": "some", "values": ["derive", "effect"] },
				"network": { "name": "some", "values": ["http", "tcp"] },
				"instance": { "name": "flag", "value": true },
				"sandbox": { "name": "some", "values": [] }
			},
