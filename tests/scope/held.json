					"refused": null
				}
			]
		},
		{
			"what": "an active scope allowed derive and http alone, a need failing on several capabilities",
			"bundle": {
				"scope": 7,
				"generation": 4,
				"issuer": {
					"grants": [],
					"allowance": {
						"kind": { "name": "some", "values": ["derive"] },
						"network": { "name": "some", "values": ["http"] }
					},
					"security": "strict",
					"status": "active"
				}
			},
			"scope": 7,
			"status": "active",
			"allowance": {
				"kind": { "name": "some", "values": ["derive"] },
				"network": { "name": "some", "values": ["http"] },
				"instance": { "name": "flag", "value": false },
				"sandbox": { "name": "some", "values": [] }
			},
			"fits": [
				{
					"what": "an effect asking udp, an instance and a capability no entry names",
