					"refused": {
						"unfit": [
							{ "unknown": "gpu" },
							{
								"exceeds": "instance",
								"need": { "name": "flag", "value": true },
								"held": { "name": "flag", "value": false }
							},
							{
								"exceeds": "kind",
								"need": { "name": "one", "value": "effect" },
								"held": { "name": "some", "values": ["derive"] }
							},
							{
								"exceeds": "network",
								"need": { "name": "some", "values": ["http", "udp"] },
								"held": { "name": "some", "values": ["http"] }
							}
						]
					}
				},
				{
					"what": "a derive asking http alone still fitting",
					"need": { "kind": { "name": "one", "value": "derive" } },
					"refused": null
