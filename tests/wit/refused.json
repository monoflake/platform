			"lines": [
				"interface files {",
				"  resource file {",
				"    size: func() -> u64;",
				"  }",
				"  open: func(path: string) -> u32;",
				"}",
				"world main {",
				"  export files;",
				"}"
			],
			"refusals": [{ "problem": { "refused": "resource" }, "line": 2, "column": 3 }]
		},
		{
			"what": "own and borrow, each where it is",
			"lines": [
