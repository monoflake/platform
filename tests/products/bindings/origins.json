				{
					"call": "open",
					"as": "operator",
					"input": {
						"organization": {
							"$use": "organization"
						}
					},
					"expect": {
						"output": {
							"$capture": "opened"
						}
					}
				},
				{
					"call": "bind",
					"bearer": {
						"$use": "opened"
					},
					"input": {
						"reach": {
							"name": "origin",
							"origin": "http://driver.example.com"
						}
					},
					"expect": {
						"failure": "rejected",
						"reason": "malformed"
					}
