{
	"interface": "bindings",
	"cases": [
		{
			"description": "an organization that is not open is given no binding",
			"steps": [
				{
					"call": "open",
					"as": "operator",
					"input": {
						"organization": 4294967295
					},
					"expect": {
						"failure": "rejected",
						"reason": "not_found"
					}
				}
			]
		},
		{
			"description": "an origin over plain http is malformed",
