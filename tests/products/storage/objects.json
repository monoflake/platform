		{
			"description": "an extension that breaks an object's rules is refused",
			"given": {
				"records": [
					{
						"kind": "bucket",
						"handle": "objects",
						"content": {
							"type": "object",
							"kind": {
								"name": "packed"
							},
							"placement": {
								"availability": "best_effort",
								"durability": "persistent",
								"custody": "false"
							},
							"spread": {
								"copies": 1,
								"distinct": {}
							},
							"access": "private"
						}
					}
				]
			},
			"steps": [
				{
					"call": "object_write",
					"input": {
						"bucket": "objects",
						"content": "aGVsbG8",
						"extension": "-x"
					},
					"expect": {
						"failure": "rejected",
						"reason": "extension_invalid"
					}
				},
				{
					"call": "object_write",
					"input": {
						"bucket": "objects",
						"content": "aGVsbG8",
						"extension": "a..b"
					},
					"expect": {
						"failure": "rejected",
						"reason": "extension_invalid"
					}
				},
				{
					"call": "object_write",
					"input": {
						"bucket": "objects",
						"content": "aGVsbG8",
						"extension": "abcdefghijklmnopq"
					},
					"expect": {
						"failure": "rejected",
						"reason": "extension_invalid"
					}
				},
				{
					"call": "object_list",
					"input": {
						"bucket": "objects"
					},
					"expect": {
						"output": {
							"objects": []
						}
					}
				}
			]
		},
