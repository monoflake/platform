{
	"interface": "storage",
	"cases": [
		{
			"description": "an object is named by its content and extension, and read and described by that name",
			"given": {
				"records": [
					{
						"kind": "bucket",
						"handle": "objects",
						"content": {
							"type": "object",
							"kind": {
								"name": "packed"
							},
							"placement": {
								"availability": "best_effort",
								"durability": "persistent",
								"custody": "false"
							},
							"spread": {
								"copies": 1,
								"distinct": {}
							},
							"access": "private"
						}
					}
				]
			},
			"steps": [
				{
					"call": "object_write",
					"input": {
						"bucket": "objects",
						"content": "aGVsbG8",
						"extension": "txt"
					},
					"expect": {
						"output": {
							"object": {
								"$capture": "o"
							},
							"hash": {
								"$any": true
							},
							"size": 5
						}
					}
				},
				{
					"call": "object_read",
					"input": {
						"bucket": "objects",
						"object": {
							"$use": "o"
						}
					},
					"expect": {
						"output": {
							"content": "aGVsbG8",
							"size": 5
						}
					}
				},
				{
					"call": "object_describe",
					"input": {
						"bucket": "objects",
						"object": {
							"$use": "o"
						}
					},
					"expect": {
						"output": {
							"size": 5
						}
					}
				}
			]
		},
