{
	"interface": "storage",
	"cases": [
		{
			"description": "a file uploaded in parts is written as one, read whole, and has the hash one write gives it",
			"given": {
				"records": [
					{
						"kind": "bucket",
						"handle": "files",
						"content": {
							"type": "file",
							"kind": {
								"name": "packed"
							},
							"placement": {
								"availability": "best_effort",
								"durability": "persistent",
								"custody": "false"
							},
							"spread": {
								"copies": 1,
								"distinct": {}
							},
							"access": "private"
						}
					}
				]
			},
			"steps": [
				{
					"call": "file_upload_begin",
					"input": {
						"bucket": "files",
						"path": "big.bin",
						"size": 10
					},
					"expect": {
						"output": {
							"upload": {
								"$capture": "u"
							},
							"part": 16777216
						}
					}
				},
				{
					"call": "file_upload_append",
					"input": {
						"upload": {
							"$use": "u"
						},
						"offset": 0,
						"content": "aGVsbG8"
					},
					"expect": {
						"output": {
							"received": 5,
							"durable": {
								"$any": true
							}
						}
					}
				},
				{
					"call": "file_upload_describe",
					"input": {
						"upload": {
							"$use": "u"
						}
					},
					"expect": {
						"output": {
							"received": 5,
							"durable": {
								"$any": true
							}
						}
					}
				},
				{
					"call": "file_upload_append",
					"input": {
						"upload": {
							"$use": "u"
						},
						"offset": 5,
						"content": "d29ybGQ"
					},
					"expect": {
						"output": {
							"received": 10,
							"durable": {
								"$any": true
							}
						}
					}
				},
				{
					"call": "file_upload_finish",
					"input": {
						"upload": {
							"$use": "u"
						}
					},
					"expect": {
						"output": {
							"hash": {
								"$capture": "h"
							},
							"size": 10
						}
					}
				},
				{
					"call": "file_read",
					"input": {
						"bucket": "files",
						"path": "big.bin"
					},
					"expect": {
						"output": {
							"content": "aGVsbG93b3JsZA",
							"size": 10,
							"hash": {
								"$use": "h"
							}
						}
					}
				},
				{
					"call": "file_write",
					"input": {
						"bucket": "files",
						"path": "small.bin",
						"content": "aGVsbG93b3JsZA"
					},
					"expect": {
						"output": {
							"hash": {
								"$use": "h"
							},
							"size": 10
						}
					}
				},
				{
					"call": "file_upload_describe",
					"input": {
						"upload": {
							"$use": "u"
						}
					},
					"expect": {
						"failure": "rejected",
						"reason": "not_found"
					}
				}
			]
		},
