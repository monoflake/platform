{
	"interface": "management",
	"cases": [
		{
			"description": "a binding new holds nothing, and its grace is a week",
			"steps": [
				{
					"call": "describe",
					"input": {},
					"expect": { "output": { "generation": 0, "policy": 0, "grace": 604800, "items": [] } }
				}
			]
		},
		{
			"description": "a list applied is held, and each item is made at an address, its credentials never shown",
			"steps": [
				{
					"call": "apply",
					"input": {
						"generation": 1,
						"items": [
							{
								"id": 1,
								"capacity": { "name": "object", "size": 1048576 },
								"credentials": ["af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262"]
							}
						]
					},
					"expect": { "output": { "generation": 1 } }
				},
				{
					"call": "describe",
					"input": {},
					"within": 60000,
					"expect": {
						"output": {
							"generation": 1,
							"policy": 0,
							"grace": 604800,
							"items": [
								{
									"id": 1,
									"capacity": { "name": "object", "size": 1048576 },
									"state": { "name": "made", "address": { "$any": null } }
								}
							]
						}
					}
				}
			]
		},
