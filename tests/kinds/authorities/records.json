		{
			"description": "a working key is certified for the issuer or the bundle, and refused any other role",
			"steps": [
				{
					"call": "certify",
					"input": {
						"key": {
							"key": {
								"kty": "okp",
								"crv": "ed25519",
								"x": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
							}
						},
						"role": "issuer"
					},
					"expect": {
						"output": {
							"certificate": {
								"$signed": {
									"record": "certificate",
									"claims": {
										"iat": {
											"$any": true
										},
										"exp": {
											"$any": true
										},
										"cnf": {
											"key": {
												"kty": "okp",
												"crv": "ed25519",
												"x": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
											}
										},
										"scope": {
											"$any": true
										},
										"role": "issuer"
									}
								}
							}
						}
					}
				},
				{
					"call": "certify",
					"input": {
						"key": {
							"key": {
								"kty": "okp",
								"crv": "ed25519",
								"x": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
							}
						},
						"role": "bundle"
					},
					"expect": {
						"output": {
							"certificate": {
								"$signed": {
									"record": "certificate",
									"claims": {
										"iat": {
											"$any": true
										},
										"exp": {
											"$any": true
										},
										"cnf": {
											"key": {
												"kty": "okp",
												"crv": "ed25519",
												"x": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
											}
										},
										"scope": {
											"$any": true
										},
										"role": "bundle"
									}
								}
							}
						}
					}
				},
				{
					"call": "certify",
