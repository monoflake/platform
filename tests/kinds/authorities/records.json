{
	"interface": "authority",
	"cases": [
		{
			"description": "a control holding nothing pulls the record its authority signs: its certificate, allowance, loans and status",
			"steps": [
				{
					"call": "pull",
					"input": {},
					"expect": {
						"output": {
							"record": {
								"$signed": {
									"record": "authority",
									"claims": {
										"generation": {
											"$any": true
										},
										"certificate": {
											"$any": true
										},
										"allowance": {},
										"loans": [],
										"status": "active"
									}
								}
							}
						}
					}
				}
			]
		},
		{
			"description": "a pull holding the generation there is answers it again, and one holding a later one is refused, so no record is taken back",
			"given": {
				"generation": 5
			},
			"steps": [
				{
					"call": "pull",
					"input": {
						"holding": 5
					},
					"expect": {
						"output": {
							"record": {
								"$signed": {
									"record": "authority",
									"claims": {
										"generation": 5,
										"certificate": {
											"$any": true
										},
										"allowance": {},
										"loans": [],
										"status": "active"
									}
								}
							}
						}
					}
				},
				{
					"call": "pull",
					"input": {
						"holding": 4
					},
					"expect": {
						"output": {
							"record": {
								"$signed": {
									"record": "authority",
									"claims": {
										"generation": 5,
										"certificate": {
											"$any": true
										},
										"allowance": {},
										"loans": [],
										"status": "active"
									}
								}
							}
						}
					}
				},
				{
					"call": "pull",
					"input": {
						"holding": 6
					},
					"expect": {
						"failure": "rejected",
						"reason": "ahead"
					}
				}
			]
		},
