								"x": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
							}
						},
						"role": "component"
					},
					"expect": {
						"failure": "rejected",
						"reason": "role_refused"
					}
				}
			]
		},
		{
